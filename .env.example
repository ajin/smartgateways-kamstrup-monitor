# Copy to .env and adjust. Every line is optional.
#
# Most settings are changed in the dashboard (Settings page) and saved in data/settings.json.
# This file is only for what Docker needs before the dashboard starts.

# Your time zone, so days and hours line up with your own clock (e.g. Europe/Amsterdam).
TZ=Europe/Amsterdam

# Web port on this computer.
PORT=8080

# Forgot the dashboard password? Set this, restart (docker compose up -d), sign in with the default
# password "kamstrup" and choose a new one. Then remove this line again: while it is set, every
# restart puts the default password back.
# RESET_PASSWORD=true

# Optional starting values for a new installation. Once saved on the Settings page, the saved value wins.
# GATEWAY=192.168.1.50:82      # IP address (and port) of the Kamst-IR gateway
# POLL_INTERVAL=60             # seconds between readings (the gateway reads the meter about once a minute)
# REQUIRE_SIGNIN=true          # false = no password; anyone on your network can open the dashboard
